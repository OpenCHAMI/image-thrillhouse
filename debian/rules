#!/usr/bin/make -f
# -*- makefile -*-

# Uncomment this to turn on verbose mode.
#export DH_VERBOSE=1

# Version stamped into the binary: derived from git (the release tag, or
# `git describe` output for untagged commits — see scripts/version.sh).
# Without a git checkout, fall back to the upstream part of the changelog
# version (dropping the "-1" Debian revision), converted back to the form a
# git checkout would report (0.0.27+3.gabc1234 -> v0.0.27-3-gabc1234).
APP_VERSION := $(shell sh scripts/version.sh || sh scripts/version.sh --from-package "$$(dpkg-parsechangelog -SVersion | sed 's/-[^-]*$$//')")

%:
	dh $@

override_dh_auto_build:
	go build -v -tags "exclude_graphdriver_btrfs exclude_graphdriver_devicemapper" \
		-ldflags "-X main.version=$(APP_VERSION)" \
		-o image-thrillhouse ./cmd/image-thrillhouse

override_dh_auto_install:
	install -D -m 0755 image-thrillhouse debian/image-thrillhouse/usr/bin/image-thrillhouse

override_dh_auto_test:
	# Skip tests during package build as they require Linux-specific dependencies
	# and container runtime environment

override_dh_auto_clean:
	rm -f image-thrillhouse

override_dh_dwz:
	# Skip dwz debug symbol compression - Go binaries have compressed debug sections
	# that are incompatible with dwz
